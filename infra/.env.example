# K-one v2 — environment (production compose)
# Copy to .env and adjust.

PG_DB=k_one
PG_USER=kone
PG_PASS=kone

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=12

WORKER_CONCURRENCY=2

# Base path the frontend uses for API calls (nginx-proxied to api service).
VITE_API_BASE=/k-one/api